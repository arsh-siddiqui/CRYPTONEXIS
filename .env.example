# ==========================================
# CRYPTONEXIS APPLICATION ENVIRONMENT
# ==========================================

APP_ENV=development
DATA_MODE=demo


# ==========================================
# BLOCKCHAIN DATA PROVIDERS
# ==========================================

# Bitcoin
# Blockchain.com public Blockchain Data API
# No API key required for the selected raw address endpoint.
BLOCKCHAIN_API_KEY=


# Ethereum
# Etherscan API V2
# Ethereum Mainnet = chainid=1
ETHERSCAN_API_KEY=your_real_etherscan_api_key_here


# BNB Smart Chain
# Ankr Multichain / Query API
# BSC = blockchain "bsc"
ANKR_API_KEY=your_real_ankr_api_key_here


# ==========================================
# OPTIONAL / UNUSED PROVIDERS
# ==========================================

# BscScan is NOT used by the current Cryptonexis architecture.
BSCSCAN_API_KEY=

# Moralis was tested but is NOT the active BSC provider.
MORALIS_API_KEY=


# ==========================================
# THREAT INTELLIGENCE
# ==========================================

# These are planned for later phases.
# Leave empty until the corresponding provider
# is actually selected and implemented.

AMLBOT_API_KEY=
CRYPTOSCAMDB_API_KEY=
CHAINABUSE_API_KEY=